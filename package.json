{
  "name": "ai-whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Chrome extension that adds a whiteboard input method to ChatGPT (and, in later phases, Claude and Gemini).",
  "author": "snowtone-ai",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "4.18.0",
      "nanoid@<4.0.0": "3.3.18",
      "nanoid@>=4.0.0 <6.0.0": "5.1.16"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter @ai-whiteboard/extension dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @ai-whiteboard/extension build",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "eslint": "^9.24.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}
