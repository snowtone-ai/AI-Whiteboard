# AI Whiteboard intentionally stores API keys through Electron safeStorage, not .env files.
# Keep this file as names and safe defaults only; never copy real credentials here.

AI_WHITEBOARD_DEFAULT_PROVIDER=openai
AI_WHITEBOARD_DEFAULT_MODEL_OPENAI=gpt-5.6-luna
AI_WHITEBOARD_DEFAULT_MODEL_ANTHROPIC=claude-sonnet-5
AI_WHITEBOARD_DEFAULT_MODEL_GEMINI=gemini-3.7-flash
# Optional local workspace override. Empty means the platform data directory.
AI_WHITEBOARD_DATA_DIR=
